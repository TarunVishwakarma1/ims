# Copy to .env (or .env.local for docker compose) and fill in real values.
# JWT_SECRET / PAYLOAD_ENCRYPTION_KEY: generate via `openssl rand -hex 32`.

ENV=development
PORT=8080
DATABASE_URL=
VALKEY_URL=redis://localhost:6379/0
JWT_SECRET=super-secret-jwt-key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
ALLOWED_ORIGINS=http://localhost:3000

# RazorPay payment gateway
RAZORPAY_WEBHOOK_SECRET_TEST=
RAZORPAY_WEBHOOK_SECRET_LIVE=
RAZORPAY_MOCK_MODE=true
RAZORPAY_LIVE_MODE=false
RAZORPAY_TEST_API_KEY=
RAZOR_PAY_SECRET=
RAZORPAY_LIVE_API_KEY=
RAZOR_PAY_LIVE_SECRET=

# AES-256 key (hex-encoded 32 bytes) for at-rest payload encryption
PAYLOAD_ENCRYPTION_KEY=

# Observability
METRICS_ENABLED=true
METRICS_TOKEN=
LOG_FILE_PATH=logs/backend.log

# OpenTelemetry — set OTEL_EXPORTER=otlp + OTEL_ENDPOINT=host:4317 for
# Tempo/Jaeger. Default (unset) writes pretty-printed spans to stdout.
OTEL_EXPORTER=
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=ims-backend

# Email notifications. Leave SMTP_HOST blank for dev log-only mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=IMS Notifications
WEB_APP_URL=http://localhost:3000
