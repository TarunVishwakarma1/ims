## Non-secret runtime config for the Docker compose stack.
## Real secrets (JWT_SECRET, RazorPay keys, encryption key) live in
## .env.local — gitignored, loaded after this file so its values win.
## Both files are referenced in docker-compose.yml's env_file list.

ENV=development
PORT=8080
DATABASE_URL=postgres://ims:yourpassword@postgres:5432/ims_db
VALKEY_URL=redis://valkey:6379/0
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
ALLOWED_ORIGINS=http://localhost:3000
RAZORPAY_MOCK_MODE=false
RAZORPAY_LIVE_MODE=true

# B2C shop. Org auto-resolved by slug at boot (migration 000020 seeds
# 'kirana'; helper in main.go self-heals if missing). Override via
# SHOP_ORG_SLUG / SHOP_ORG_NAME / SHOP_ORG_ID env if you need a different
# org per environment.
SHOP_ENABLED=true
SHOP_COD_MIN_PAISE=10000
SHOP_COD_MAX_PAISE=500000

# Dev-only: seed Kirana catalog with 5 categories + 20 demo products + inventory
# on boot. Idempotent (ON CONFLICT DO NOTHING). MUST be unset/false in prod.
SEED_DEV_DATA=true

METRICS_ENABLED=true

# Email notifications. Leave SMTP_HOST blank for log-only dev mode.
# Hostinger:    SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465 (SMTPS) or 587 (STARTTLS)
# Hostinger Titan: SMTP_HOST=smtp.titan.email instead (check Hostinger panel)
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 (use app-password).
# SendGrid:     SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USERNAME=apikey.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=hello@tarunvishwakarma.dev
# Sender must match SMTP_USERNAME for Hostinger (DMARC/SPF).
SMTP_FROM_EMAIL=hello@tarunvishwakarma.dev
SMTP_FROM_NAME=IMS Notifications
# SMTP_PASSWORD goes in .env.local (gitignored).
WEB_APP_URL=http://localhost:3000
